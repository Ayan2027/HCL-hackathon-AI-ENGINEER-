# ---------------------------------------------------------------
# ShopSense AI - environment settings
# Copy this file to ".env" and fill in your Groq key.
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# NEVER commit the real .env file (it is in .gitignore).
# ---------------------------------------------------------------

# ---- LLM (Groq Cloud) ----
GROQ_API_KEY=your_groq_api_key_here
# Default = Groq's recommended replacement for the retired llama-3.3-70b-versatile.
# Run "python -m scripts.check_setup" to list the models your key can use.
GROQ_MODEL=openai/gpt-oss-120b
# true  = no API calls, rule-based intent + template answers (fast, offline)
# false = real Groq calls (falls back to mock automatically if the key is missing)
MOCK_LLM=true
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800

# ---- Storage ----
DB_PATH=data/shopsense.db
INDEX_DIR=data/index
# ShopMate catalogue: JSON is the source of truth, CSV is only cross-checked against it
CATALOG_JSON=data/shopmate_products.json
CATALOG_CSV=data/shopmate_products.csv
BACKUP_DIR=data/backups

# ---- Embeddings / retrieval ----
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MODEL_CACHE_DIR=models
# true = hybrid search (FTS5 + FAISS, fused with RRF). Needs faiss-cpu, i.e. Python 3.12 (.venv312),
#        and an index built with:  python -m scripts.build_index
# false = keyword-only search (FTS5). The app works fully, just with less semantic recall.
USE_VECTOR_SEARCH=true
RETRIEVAL_K=30
TOP_K=3
SEMANTIC_WEIGHT=0.5

# ---- Conversation ----
MAX_CLARIFICATIONS=2
HISTORY_TURNS=6

# ---- Frontend -> API ----
API_URL=http://localhost:8000

LOG_LEVEL=INFO
